{
  "name": "vitepress-lang",
  "version": "0.1.0",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.61.0",
    "rolldown": "^1.0.0-rc.17",
    "typescript": "^5.8.0",
    "vitepress": "^2.0.0-alpha.17"
  },
  "scripts": {
    "build": "rolldown -c && tsc --emitDeclarationOnly",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "Default VitePress UI translations for themeConfig (default theme). Ready-to-use translated strings for search, nav, sidebar, and other interface elements.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locales/en": {
      "types": "./dist/locales/en.d.ts",
      "import": "./dist/locales/en.js"
    },
    "./locales/de": {
      "types": "./dist/locales/de.d.ts",
      "import": "./dist/locales/de.js"
    },
    "./locales/hu": {
      "types": "./dist/locales/hu.d.ts",
      "import": "./dist/locales/hu.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "AGPL-3.0-only",
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts"
}
